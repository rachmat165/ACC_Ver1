# ============================================================
# ARUNIKA COMMAND CENTRE - Environment Variables
# Salin file ini ke data/.env dan isi nilai yang sebenarnya
# ============================================================

# --- AI Provider (pilih salah satu sebagai active di config.yaml) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- OpenRouter (akses 100+ model via 1 API key) ---
# Daftar & ambil key di: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Contoh model: anthropic/claude-sonnet-4-5, openai/gpt-4o, google/gemini-pro
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5

# --- LM Studio (model AI lokal di komputer sendiri, GRATIS) ---
# Download LM Studio di: https://lmstudio.ai
# Jalankan LM Studio -> Load model -> Start Local Server
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=local-model
# LM Studio tidak butuh API key, tapi field ini harus diisi
LM_STUDIO_API_KEY=lm-studio

# --- Model default & fallback ---
# Sonnet 4.5: cepat, pintar, harga reasonable (RECOMMENDED)
# Opus 4.8: paling pintar tapi mahal & temperature deprecated
ACC_PRIMARY_MODEL=claude-sonnet-4-5
ACC_FALLBACK_MODEL=gpt-4o

# --- WhatsApp via Twilio ---
# Daftar di https://console.twilio.com -> WhatsApp Sandbox
WA_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
# Sandbox: +14155238886 (default Twilio global sandbox)
# Production: nomor WhatsApp Business yang sudah diverifikasi
WA_FROM_NUMBER=+14155238886
WA_SANDBOX_MODE=true
# Template default (opsional). Format: HXxxxxxxxxxxxxxx
WA_DEFAULT_TEMPLATE_SID=

# --- Webhook Server ---
# URL publik webhook server (dari ngrok atau domain sendiri)
# Format: https://xxxx.ngrok.io (TANPA trailing slash)
WA_WEBHOOK_URL=
# Port webhook server lokal (default: 5000)
ACC_WEBHOOK_PORT=5000
# Mode debug Flask (true/false)
ACC_DEBUG=false

# --- Lainnya ---
ACC_OPERATOR_MODE=api_key
